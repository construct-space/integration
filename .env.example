# integration-api — copy to .env for local, set in CapRover for prod.

PORT=8020
APP_URL=http://localhost:8020
ALLOWED_ORIGINS=https://my.lisaos.dev,tauri://localhost,http://localhost:3000

# DB
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=construct_integration
DB_USER=root
DB_PASS=

# Peer-service auth (matches INTERNAL_SHARED_SECRET on source / accounts)
INTERNAL_SHARED_SECRET=

# 64 hex chars = 32 bytes / 256 bits. Generate with:
#   openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=

# Accounts service (for token validation; currently unused — gateway
# pre-validates and forwards X-Auth-* headers).
ACCOUNTS_URL=https://accounts.lisaos.dev

# Google OAuth (Web application client). Get from console.cloud.google.com.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://integration-api.lisaos.dev/api/integration/google/callback

# Deep link the callback redirects the browser to after success.
# Tauri host registers construct:// scheme.
POST_CALLBACK_DEEP_LINK=construct://app/mail/settings
